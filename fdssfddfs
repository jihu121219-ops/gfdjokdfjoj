-- [[ 스킨 변경 기능 함수 ]] --
local function changeSkin(gunName, skinName, wrapName, charmName)
	if not gunName then return end

	local Players = game:GetService("Players")
	local player = Players.LocalPlayer

	local normalModel
	for _, thing in ipairs(player.PlayerScripts.Assets.ViewModels:GetDescendants()) do
		if thing:IsA("Model") and thing.Name == gunName then
			normalModel = thing
			break
		end
	end
	if not normalModel then return end


	local viewmodels = itemLib.ViewModels
	local cosmetics = cosmeticLib.Cosmetics
	local ogViewmodel = viewmodels[gunName]

	if skinName then
		local skinCosmetic = cosmetics[skinName]
		if not skinCosmetic or skinCosmetic.Type ~= "Skin" then return end

		local skinModel
		for _, thing in ipairs(game:GetService("StarterPlayer").StarterPlayerScripts.Assets.ViewModels:GetDescendants()) do
			if thing:IsA("Model") and thing.Name == skinName then
				skinModel = thing
				break
			end
		end

		if not skinModel then return end

		local skinViewmodel = viewmodels[skinName]
		if not ogViewmodel or not skinViewmodel then return end

		ogViewmodel.Image = skinViewmodel.Image or ogViewmodel.Image
		ogViewmodel.ImageHighResolution = skinViewmodel.ImageHighResolution or ogViewmodel.ImageHighResolution
		ogViewmodel.ImageCentered = skinViewmodel.ImageCentered or ogViewmodel.ImageCentered
		ogViewmodel.EliminationFeedImage = skinViewmodel.EliminationFeedImage or ogViewmodel.EliminationFeedImage
		ogViewmodel.EliminationFeedImageScale = skinViewmodel.EliminationFeedImageScale or ogViewmodel.EliminationFeedImageScale
		ogViewmodel.RootPartOffset = skinViewmodel.RootPartOffset or ogViewmodel.RootPartOffset

		ogViewmodel.Animations = {}
		for animType, animName in pairs(skinViewmodel.Animations) do ogViewmodel.Animations[animType] = animName end

		normalModel:ClearAllChildren()

		for _, part in ipairs(skinModel:GetChildren()) do
			part:Clone().Parent = normalModel
		end
	end

	if wrapName then
		local wrapCosmetic = cosmetics[wrapName]
		if not wrapCosmetic or wrapCosmetic.Type ~= "Wrap" then return end

		local equipped = { [gunName] = {} }

		if wrapName == "None" or wrapName == "" then
			equipped[gunName].Wrap = nil
		else
			local wrapData = {}
			for k, v in pairs(wrapCosmetic) do
				wrapData[k] = v
			end
			wrapData.Name = wrapName
			wrapData.Type = "Wrap"
			wrapData.Seed = wrapData.Seed or math.random(1, 1000000)

			local EnumLibModule = game:GetService("ReplicatedStorage").Modules:FindFirstChild("EnumLibrary")
			if EnumLibModule then
				local ok, EnumLib = pcall(require, EnumLibModule)
				if ok and EnumLib and EnumLib.ToEnum then
					local ok2, enumVal = pcall(EnumLib.ToEnum, EnumLib, wrapName)
					if ok2 and enumVal then
						wrapData.Enum = enumVal
						wrapData.ObjectID = wrapData.ObjectID or enumVal
					end
				end
			end

			equipped[gunName].Wrap = wrapData
		end

		local ok, ClientItem = pcall(function()
			return require(player.PlayerScripts.Modules.ClientReplicatedClasses.ClientFighter.ClientItem)
		end)

		if ok and ClientItem and ClientItem._CreateViewModel then
			local old = ClientItem._CreateViewModel
			ClientItem._CreateViewModel = function(self, vmRef)
				local isLocal = self.ClientFighter and self.ClientFighter.Player == player
				if isLocal and equipped[self.Name] and equipped[self.Name].Wrap and vmRef then
					local dataKey = self:ToEnum("Data")
					local wrapKey = self:ToEnum("Wrap")
					if vmRef[dataKey] then
						vmRef[dataKey][wrapKey] = equipped[self.Name].Wrap
					elseif vmRef.Data then
						vmRef.Data.Wrap = equipped[self.Name].Wrap
					end
				end
				return old(self, vmRef)
			end
		end
	end

	if charmName then
		local charmCosmetic = cosmetics[charmName]
		if not charmCosmetic or charmCosmetic.Type ~= "Charm" then return end

		for _, obj in ipairs(normalModel:GetChildren()) do
			if obj.Name == "__CHARM" then obj:Destroy() end
		end

		if charmName == "None" or charmName == "" then return end

		local charmFolder = game:GetService("StarterPlayer").StarterPlayerScripts.Assets:FindFirstChild("Charms")
		if not charmFolder then return end

		local charmModel = charmFolder:FindFirstChild(charmName)
		if not charmModel then return end

		local weaponAttach
		for _, d in ipairs(normalModel:GetDescendants()) do
			if d:IsA("Attachment") and d.Name == "_charm_pivot_attachment" then
				weaponAttach = d
				break
			end
		end
		if not weaponAttach then return end
	end
end

