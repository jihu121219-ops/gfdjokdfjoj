-- [[ 4. 핵심 고정 에임봇 & 타겟팅 로직 ]] --
local function getClosestPlayerToCursor()
    local target = nil
    local shortestDistance = FOVRadius
    for _, v in pairs(plrs:GetPlayers()) do
        if v ~= lp and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            local head = v.Character:FindFirstChild("Head")
            if head then
                local pos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local distance = (Vector2.new(pos.X, pos.Y) - uis:GetMouseLocation()).Magnitude
                    if distance < shortestDistance then
                        target = head
                        shortestDistance = distance
                    end
                end
            end
        end
    end
    return target
end

-- [[ 5. 기존의 모든 RenderStepped 로직 (비행, 스핀, 에임봇 통합) ]] --
rs.RenderStepped:Connect(function()
    if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
        local char = lp.Character
        local hrp = char.HumanoidRootPart
        local hum = char:FindFirstChildOfClass("Humanoid")
        local cam = workspace.CurrentCamera

        -- 에임봇 고정 (수정된 로직)
        if AimbotEnabled and uis:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            local target = getClosestPlayerToCursor()
            if target then
                cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, target.Position), AimbotSmoothing)
            end
        end
        
        -- 비행 (기존 코드 그대로 복구)
        if FlyEnabled then
            local moveDir = Vector3.zero
            if uis:IsKeyDown("W") then moveDir += cam.CFrame.LookVector end
            if uis:IsKeyDown("S") then moveDir -= cam.CFrame.LookVector end
            if uis:IsKeyDown("A") then moveDir -= cam.CFrame.RightVector end
            if uis:IsKeyDown("D") then moveDir += cam.CFrame.RightVector end
            hrp.Velocity = moveDir * FlySpeed
        end
        
        -- 스핀봇 (기존 사지분해 로직 그대로 복구)
        if SpinEnabled then
            local t = tick()
            hrp.CFrame *= CFrame.Angles(0, math.rad(SpinSpeed), 0)
            if hum then hum.PlatformStand = true end
            local neck = char:FindFirstChild("Head") and char.Head:FindFirstChild("Neck")
            if neck then neck.C0 = CFrame.new(0, 1 + math.sin(t*20)*0.5, 0) * CFrame.Angles(math.rad(t*900%360), math.rad(t*800%360), 0) end
            local waist = char:FindFirstChild("UpperTorso") and char.UpperTorso:FindFirstChild("Waist")
            if waist then waist.C0 = CFrame.new(0, 0.8 + math.sin(t*15)*0.7, 0) * CFrame.Angles(0, math.rad(t*1000%360), math.rad(math.sin(t*10)*40)) end
            local rs_ = char:FindFirstChild("RightUpperArm") and char.RightUpperArm:FindFirstChild("RightShoulder")
            if rs_ then rs_.C0 = CFrame.new(1.5 + math.cos(t*25)*0.5, 0.5, 0) * CFrame.Angles(math.rad(t*1200%360), 0, 0) end
            local ls_ = char:FindFirstChild("LeftUpperArm") and char.LeftUpperArm:FindFirstChild("LeftShoulder")
            if ls_ then ls_.C0 = CFrame.new(-1.5 - math.cos(t*25)*0.5, 0.5, 0) * CFrame.Angles(math.rad(t*1200%360), 0, 0) end
        else
            if hum and hum.PlatformStand then hum.PlatformStand = false end -- 스핀 해제 복구 로직
        end

        -- 자동 획득
        if tick() % 0.5 < 0.03 then
            for _, obj in pairs(workspace:GetChildren()) do
                if obj.Name == "_drop" and obj:IsA("BasePart") then
                    firetouchinterest(hrp, obj, 0)
                    firetouchinterest(hrp, obj, 1)
                end
            end
        end
    end
end)

-- [[ 6. 투사체 월뱅 로직 (기존 코드 그대로 유지) ]] --
local currentTargetHitbox = nil
task.spawn(function()
    while task.wait(0.1) do
        if not (idk or SilentAimEnabled) then currentTargetHitbox = nil continue end
        currentTargetHitbox = getClosestPlayerToCursor()
    end
end)
workspace.ChildAdded:Connect(function(v)
    task.wait()
    if (idk or SilentAimEnabled) and currentTargetHitbox then
        local pNames = {["CoreProjectile"]=true, ["Slingshot"]=true, ["Daggers"]=true, ["Bow"]=true, ["Paintball Gun"]=true, ["Bullet"]=true}
        if pNames[v.Name] or v:IsA("BasePart") then
            task.spawn(function()
                local s = tick()
                while v and v.Parent and (tick() - s) < 1.5 do
                    if currentTargetHitbox then
                        v.CFrame = currentTargetHitbox.CFrame
                        v.AssemblyLinearVelocity = Vector3.zero
                        if firetouchinterest then firetouchinterest(currentTargetHitbox, v, 0) firetouchinterest(currentTargetHitbox, v, 1) end
                    end
                    task.wait()
                end
            end)
        end
    end
end)

