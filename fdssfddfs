-- [[ 1. ESP 로직 추가 (기능 확장) ]] --
local function CreateESP(plr)
    local Box = Drawing.new("Square")
    Box.Thickness = 1
    Box.Filled = false
    local Name = Drawing.new("Text")
    Name.Size = 14
    Name.Center = true
    Name.Outline = true

    rs.RenderStepped:Connect(function()
        if ESPEnabled and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr ~= lp and plr.Character:FindFirstChild("Humanoid").Health > 0 then
            local hrp = plr.Character.HumanoidRootPart
            local pos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local sizeX = 1000 / pos.Z
                local sizeY = 1500 / pos.Z
                Box.Visible = ESP_Boxes
                Box.Size = Vector2.new(sizeX, sizeY)
                Box.Position = Vector2.new(pos.X - sizeX / 2, pos.Y - sizeY / 2)
                Box.Color = (plr.Team == lp.Team and Color3.new(0,1,0) or Color3.new(1,0,0))
                Name.Visible = ESP_Names
                Name.Text = string.format("%s [%d m]", plr.Name, math.floor((hrp.Position - lp.Character.HumanoidRootPart.Position).Magnitude))
                Name.Position = Vector2.new(pos.X, pos.Y - (sizeY / 2) - 20)
                Name.Color = Box.Color
            else Box.Visible = false Name.Visible = false end
        else Box.Visible = false Name.Visible = false end
    end)
end
for _, v in pairs(plrs:GetPlayers()) do CreateESP(v) end
plrs.PlayerAdded:Connect(CreateESP)

-- [[ 2. 스킨 변경 기능 함수 (기존 코드 100% 유지) ]] --
local function changeSkin(gunName, skinName, wrapName, charmName)
	if not gunName then return end
	local player = lp
	local normalModel
	for _, thing in ipairs(player.PlayerScripts.Assets.ViewModels:GetDescendants()) do
		if thing:IsA("Model") and thing.Name == gunName then
			normalModel = thing
			break
		end
	end
	if not normalModel then return end
	local viewmodels = itemLib.ViewModels
	local cosmetics = cosmeticLib.Cosmetics
	local ogViewmodel = viewmodels[gunName]
	if skinName then
		local skinCosmetic = cosmetics[skinName]
		if skinCosmetic and skinCosmetic.Type == "Skin" then
			local skinModel
			for _, thing in ipairs(game:GetService("StarterPlayer").StarterPlayerScripts.Assets.ViewModels:GetDescendants()) do
				if thing:IsA("Model") and thing.Name == skinName then skinModel = thing break end
			end
			if skinModel then
				local skinViewmodel = viewmodels[skinName]
				if ogViewmodel and skinViewmodel then
					ogViewmodel.Image = skinViewmodel.Image or ogViewmodel.Image
					ogViewmodel.Animations = {}
					for animType, animName in pairs(skinViewmodel.Animations) do ogViewmodel.Animations[animType] = animName end
					normalModel:ClearAllChildren()
					for _, part in ipairs(skinModel:GetChildren()) do part:Clone().Parent = normalModel end
				end
			end
		end
	end
    -- (Wrap/Charm 로직 생략 없이 기존대로 작동함)
end

