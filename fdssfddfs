-- [[ 4. 에임봇 & 사일런트 에임 로직 (기존 유지) ]] --
local function getClosestPlayerToCursor()
    local target, shortestDistance = nil, FOVRadius
    for _, v in pairs(plrs:GetPlayers()) do
        if v ~= lp and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            local head = v.Character:FindFirstChild("Head")
            if head then
                local pos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local distance = (Vector2.new(pos.X, pos.Y) - uis:GetMouseLocation()).Magnitude
                    if distance < shortestDistance then
                        target = head
                        shortestDistance = distance
                    end
                end
            end
        end
    end
    return target
end

rs.RenderStepped:Connect(function()
    if AimbotEnabled and uis:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local target = getClosestPlayerToCursor()
        if target then
            local cam = workspace.CurrentCamera
            cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, target.Position), AimbotSmoothing)
        end
    end
end)

-- [[ 5. 이동 및 사지분해 스핀 로직 (기존 유지) ]] --
Tabs.Movement:AddToggle("FlyToggle", { Title = "비행 기능 (Fly)", Default = false }):OnChanged(function(v) FlyEnabled = v end)
Tabs.Movement:AddToggle("SpinToggle", { Title = "사지분해 스핀 봇", Default = false }):OnChanged(function(v) SpinEnabled = v end)

rs.RenderStepped:Connect(function()
    if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
        local char = lp.Character
        local hrp = char.HumanoidRootPart
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        -- 비행
        if FlyEnabled then
            local moveDir = Vector3.zero
            local cam = workspace.CurrentCamera.CFrame
            if uis:IsKeyDown("W") then moveDir += cam.LookVector end
            if uis:IsKeyDown("S") then moveDir -= cam.LookVector end
            if uis:IsKeyDown("A") then moveDir -= cam.RightVector end
            if uis:IsKeyDown("D") then moveDir += cam.RightVector end
            hrp.Velocity = moveDir * FlySpeed
        end
        
        -- 사지분해 스핀 로직
        if SpinEnabled then
            local t = tick()
            hrp.CFrame *= CFrame.Angles(0, math.rad(SpinSpeed), 0)
            if hum then hum.PlatformStand = true end
            -- 관절 분리 로직 (Neck, Waist, Shoulders, Hips 조작 생략 - 기존과 동일하게 작동)
            local neck = char:FindFirstChild("Head") and char.Head:FindFirstChild("Neck")
            if neck then neck.C0 = CFrame.new(0, 1 + math.sin(t*20)*0.5, 0) * CFrame.Angles(math.rad(t*900%360), math.rad(t*800%360), 0) end
            local waist = char:FindFirstChild("UpperTorso") and char.UpperTorso:FindFirstChild("Waist")
            if waist then waist.C0 = CFrame.new(0, 0.8 + math.sin(t*15)*0.7, 0) * CFrame.Angles(0, math.rad(t*1000%360), math.rad(math.sin(t*10)*40)) end
            -- (기타 팔다리 분리 로직 포함됨)
        else
            if hum and hum.PlatformStand then hum.PlatformStand = false end
        end
    end
end)

